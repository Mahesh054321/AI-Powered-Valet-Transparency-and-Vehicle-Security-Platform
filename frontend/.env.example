# ==============================================================================
#  FRONTEND ENVIRONMENT TEMPLATE
#  Copy to `.env` (or `.env.local`). Only variables prefixed with VITE_ are
#  exposed to the browser bundle.
#
#      Windows (PowerShell):  Copy-Item .env.example .env
#      macOS / Linux:         cp .env.example .env
#
#  SECURITY NOTE
#  Anything placed in this file is PUBLIC once the app is built: Vite inlines
#  VITE_* values into the JavaScript bundle. Never put a JWT secret, database
#  password or API key here. Backend secrets live only in backend/.env.
# ==============================================================================

# Public API base path. Leave as `/api` in development: Vite proxies it to the
# Flask server (see vite.config.js), so the browser makes same-origin requests.
VITE_API_BASE_URL=/api

# Where the dev server forwards /api requests. Development machine only;
# this value is NOT shipped to the browser.
VITE_PROXY_TARGET=http://127.0.0.1:5000

VITE_PORT=5173
VITE_APP_NAME=Valet Transparency Platform

# --- Map tiles ---------------------------------------------------------------
# Leaflet needs a tile source. OpenStreetMap's public tiles require no API key,
# which keeps the project runnable offline of any paid account. If your campus
# provides a tile server or you have a Mapbox token, change these two values.
# Attribution is mandatory when using OSM tiles - keep it.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_DEFAULT_ZOOM=17

# --- Demo mode ---------------------------------------------------------------
# When the real telemetry feed is unavailable the app shows simulated GPS. This
# label is displayed in the UI next to every map so nobody mistakes simulated
# data for hardware readings.
VITE_TELEMETRY_LABEL=Simulated telemetry (demo)
