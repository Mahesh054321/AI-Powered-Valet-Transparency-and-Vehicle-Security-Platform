# ==============================================================================
#  AI-Powered Valet Transparency and Vehicle Security Platform
#  BACKEND ENVIRONMENT TEMPLATE
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values:
#
#      Windows (PowerShell):  Copy-Item .env.example .env
#      Windows (cmd):         copy .env.example .env
#      macOS / Linux:         cp .env.example .env
#
#  RULES
#   - NEVER commit `.env`. It is listed in .gitignore.
#   - NEVER hardcode these values in Python or JavaScript source files.
#   - The React frontend gets its OWN .env (frontend/.env.example). It must
#     never receive a secret, because anything sent to a browser is public.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME
# ------------------------------------------------------------------------------
FLASK_ENV=development            # development | testing | production
FLASK_DEBUG=1                    # 1 = debug/reloader on, 0 = off
APP_NAME=valet-transparency-api
API_VERSION=v1
SECRET_NAMESPACE=valet-transparency   # used as default JWT iss/aud

# ------------------------------------------------------------------------------
# 2. DATABASE  (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A - provide discrete parts (preferred; used to build the DSN):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=valet_db
POSTGRES_USER=valet_user
POSTGRES_PASSWORD=change-me-locally

# Option B - provide a full URI instead. If set, it WINS over the parts above.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql+psycopg2://valet_user:change-me-locally@localhost:5432/valet_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=0                        # 1 = log every SQL statement (noisy; dev only)

# ------------------------------------------------------------------------------
# 3. SECURITY / JWT
# ------------------------------------------------------------------------------
# Generate a strong secret, e.g. in Python:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-64-char-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=valet-transparency
JWT_AUDIENCE=valet-transparency-clients
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

# werkzeug password hashing scheme. pbkdf2:sha256 needs no extra OS libraries,
# which keeps the project runnable on a clean Windows install.
PASSWORD_HASH_SCHEME=pbkdf2:sha256
PASSWORD_HASH_ITERATIONS=600000

# Comma-separated list of allowed browser origins. Use explicit origins only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brute-force protection for POST /auth/login. After this many failed attempts
# against one address, further attempts return 429 until the window rolls over.
# The budget is charged to the email, not the client IP: behind a reverse proxy
# every caller shares one address, so an IP key would let one attacker lock out
# a whole office. The trade-off is that someone who knows your address can
# lock *you* out for up to one window -- the lesser of the two harms.
#
# NOTE: the counter is in-process, so N worker processes give an attacker N
# times the budget. A multi-worker deployment should move it to Redis or the
# database behind utils/rate_limit.py's two public functions.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Set to "false" to disable throttling entirely (not recommended).
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 4. FILE / IMAGE UPLOADS
# ------------------------------------------------------------------------------
MAX_CONTENT_LENGTH_MB=15
UPLOAD_FOLDER=storage/media
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
MIN_IMAGE_PIXELS=64
MAX_IMAGE_PIXELS=4096

# ------------------------------------------------------------------------------
# 5. DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Geofence breach threshold in metres beyond a parking zone boundary.
GEOFENCE_BUFFER_METRES=25
# Speed (km/h) above which a movement inside a parking area is suspicious.
SUSPICIOUS_SPEED_KMPH=12
# How often (seconds) simulated telemetry emits a GPS fix.
TELEMETRY_INTERVAL_SECONDS=30
# Explicitly labels the telemetry source. `simulated` | `hardware`
TELEMETRY_SOURCE=simulated

# --- Prototype ML security classifier ---------------------------------------
# All three are optional. With no trained artifact the platform classifies every
# fix with the rule engine alone, which is the fully supported default; nothing
# in the security path requires these to be set.
#
# Where the trained artifact lives. Produced by:
#   python utils/scripts/train_security_model.py
# ML_MODEL_PATH=storage/models/security_classifier.json
#
# P(SUSPICIOUS) above which the classifier may RAISE a fix's verdict. It can
# never lower one, so a geofence breach always alerts regardless of this value.
# Deliberately above 0.5: escalating on a coin flip would fill the alert queue
# with noise and teach reviewers to ignore it.
# ML_ESCALATION_THRESHOLD=0.70
#
# Set to false to run on rule-based checks alone even when an artifact exists.
# ML_ENABLED=true

# ---------------------------------------------------------------------------
# Retrieval prediction (phase 9b)
# ---------------------------------------------------------------------------
# Predicts how long a vehicle will take to bring to the handover point after the
# customer asks for it. The model is a ridge regression trained OFFLINE on
# synthetic history - see docs/AI-INTEGRITY.md. Every response it produces
# carries trained_on_synthetic_data: true.
#
# Where the trained artifact lives. Produced by:
#   python utils/scripts/train_retrieval_model.py
# RETRIEVAL_MODEL_PATH=storage/models/retrieval_model.json
#
# Set to false to disable retrieval estimation even when an artifact exists.
# The endpoint then reports itself unavailable rather than guessing.
# RETRIEVAL_ML_ENABLED=true

# ------------------------------------------------------------------------------
# 6. BOOTSTRAP ADMIN  (created by `python utils/scripts/init_db.py --seed`)
# ------------------------------------------------------------------------------
# Leave the password EMPTY to have the seeder print a generated one instead.
SEED_ADMIN_EMAIL=admin@valet.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 7. LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
JSON_LOGS=0                      # 1 = single-line JSON logs

# ------------------------------------------------------------------------------
# 8. HEALTH CHECKS
# ------------------------------------------------------------------------------
# The API answers `GET /api/health` (liveness) and `GET /api/readyz`
# (readiness; executes SELECT 1 against PostgreSQL). Neither is versioned and
# neither requires authentication, so a load balancer or an evaluator can call
# them directly. There is nothing to configure here; this block exists so the
# endpoints are discoverable.
