{
  "name": "valet-transparency-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace scripts for the AI-Powered Valet Transparency and Vehicle Security Platform",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && python utils/scripts/run_api.py",
    "dev:web": "cd frontend && npm run dev",
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd backend && python -m pip install -r requirements.txt -r requirements-dev.txt",
    "setup:frontend": "cd frontend && npm install",
    "db:init": "cd backend && python utils/scripts/init_db.py",
    "db:reset": "cd backend && python utils/scripts/init_db.py --reset --seed",
    "db:check": "cd backend && python utils/scripts/init_db.py --check-only",
    "config": "cd backend && python utils/scripts/show_config.py",
    "verify": "cd backend && python utils/scripts/verify_setup.py",
    "test:backend": "cd backend && python -m pytest",
    "test:frontend": "cd frontend && npm test",
    "test:coverage": "cd backend && python -m pytest --cov=app --cov=config --cov=routes --cov=utils --cov=database --cov=services --cov-report=term-missing",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && python -m ruff check .",
    "lint:frontend": "cd frontend && npx eslint .",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
